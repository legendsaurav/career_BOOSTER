# Frontend API base — the Career Booster backend (Linux host 172.30.8.214).
# Use the direct host or a tunnel that forwards to it.
VITE_API_BASE=http://172.30.8.214:8787

# Google Custom Search keys/CX.
# NOTE: news/jobs go through the backend proxy (/api/external/google-cse); set those keys as
# GOOGLE_CSE_KEY_<SECTION> / GOOGLE_CSE_CX_<SECTION> in the BACKEND env, not here.
# The VITE_* copies below are only used by the in-browser alumni/LinkedIn/GitHub searches.
VITE_GOOGLE_CSE_KEY_ALUMNI=your_cse_key
VITE_GOOGLE_CSE_CX_ALUMNI=your_cse_cx
VITE_GOOGLE_CSE_KEY_NEWS=your_cse_key
VITE_GOOGLE_CSE_CX_NEWS=your_cse_cx
VITE_GOOGLE_CSE_KEY_PROJECTS=your_cse_key
VITE_GOOGLE_CSE_CX_PROJECTS=your_cse_cx
VITE_GOOGLE_CSE_KEY_ANNOUNCEMENTS=your_cse_key
VITE_GOOGLE_CSE_CX_ANNOUNCEMENTS=your_cse_cx
VITE_GOOGLE_CSE_KEY_GITHUB=your_cse_key
VITE_GOOGLE_CSE_CX_GITHUB=your_cse_cx
VITE_GOOGLE_CSE_KEY_LINKEDIN=your_cse_key
VITE_GOOGLE_CSE_CX_LINKEDIN=your_cse_cx

# AI keys
VITE_GOOGLE_GENAI_KEY=your_genai_key
VITE_PERPLEXITY_API_KEY=
VITE_PERPLEXITY_MODEL=llama-3-sonar-small-32k-online

# INTERVIEWER app URL — where "Start Interview" hands off once prep is ready (?session=ID).
VITE_INTERVIEWER_URL=http://172.30.8.214:8000

# Supabase has been fully removed; the backend on 172.30.8.214 is now the system of record.
